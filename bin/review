#!/usr/bin/env ruby
# frozen_string_literal: true

require 'bundler/setup'
require 'dotenv'
require 'optparse'
require_relative '../lib/slop_guard'

options = { inspect: false, live: false, json: false }
parser = OptionParser.new do |opts|
  opts.banner = "Usage: bin/review CASE_ID [--inspect | --live]\n       " \
                'bin/review --repo PATH --base REF [--head REF] --expectations FILE [--inspect | --live]'
  opts.on('--inspect', 'Print evidence offline without contacting Jev') { options[:inspect] = true }
  opts.on('--json', 'Print a machine-readable report') { options[:json] = true }
  opts.on('--live', 'Send the selected evidence to Jev for a paid review') { options[:live] = true }
  opts.on('--repo PATH', 'Read a local Git repository without checking out or running its code') do |v|
    options[:repo] = v
  end
  opts.on('--base REF', 'Compare from the merge base with this local revision') { |v| options[:base] = v }
  opts.on('--head REF', 'Committed revision to review (default HEAD; excludes working-tree changes)') do |v|
    options[:head] = v
  end
  opts.on('--expectations FILE', 'Markdown with Expected behavior and Failure cases sections') do |v|
    options[:expectations] = v
  end
  opts.on('--rules-dir PATH', 'Explicit trusted directory with g1.yml through g4.yml') { |v| options[:rules] = v }
  opts.on('--env-file PATH', 'Load TYPESAFE_API_KEY from this ignored file when the environment does not set it') do |v|
    options[:env_file] = v
  end
end
begin
  parser.parse!
  raise SlopGuard::InvalidInput, parser.to_s unless [options[:inspect], options[:live]].count(true) == 1

  if options[:repo]
    raise SlopGuard::InvalidInput, parser.to_s unless ARGV.empty? && options[:base] && options[:expectations]

    body = File.binread(options[:expectations], 16_385).force_encoding(Encoding::UTF_8)
    source = SlopGuard::GitSource.new(repository: options[:repo], base: options[:base], head: options[:head] || 'HEAD')
    snapshot = SlopGuard::Snapshot.new(source.input(pr_body: body), profile: source.profile)
    rules = SlopGuard::Rules.new(options.fetch(:rules, File.join(SlopGuard::ROOT, 'config/rules')),
                                 repository: !options.key?(:rules))
  else
    unless ARGV.size == 1 && options.values_at(:base, :head, :expectations, :rules).all?(&:nil?)
      raise SlopGuard::InvalidInput, parser.to_s
    end

    dataset = SlopGuard::Dataset.new(File.join(SlopGuard::ROOT, 'eval'))
    snapshot = SlopGuard::Snapshot.new(dataset.input(ARGV.first))
    rules = SlopGuard::Rules.new
  end
  if options[:inspect]
    puts JSON.pretty_generate('snapshot' => snapshot.identity, 'gaps' => snapshot.gaps,
                              'expectation_gaps' => snapshot.expectations.gaps,
                              'skipped_paths' => snapshot.skipped, 'source' => source&.metadata,
                              'rules_revision' => rules.revision,
                              'state_bytes' => JSON.generate(snapshot.state).bytesize,
                              'evidence' => snapshot.state)
  else
    # Credentials come from the environment; a file is read only when explicitly named. Environment wins.
    env_file = options[:env_file] || ENV.fetch('SLOP_GUARD_ENV_FILE', nil)
    if env_file
      raise SlopGuard::InvalidInput, "Credential file does not exist: #{env_file}" unless File.file?(env_file)

      Dotenv.load(env_file)
    end
    api_key = ENV.fetch('TYPESAFE_API_KEY', '')
    raise SlopGuard::ProviderError, 'TYPESAFE_API_KEY is not configured' if api_key.strip.empty?

    directory = File.join(SlopGuard::ROOT, 'tmp/reviews', "#{Time.now.utc.strftime('%Y%m%dT%H%M%S')}-#{Process.pid}")
    budget = SlopGuard::Budget.new(ledger: File.join(directory, 'requests.jsonl'))
    client = SlopGuard::JevClient.new(api_key: api_key, budget: budget)
    report = SlopGuard::Evaluator.new(client: client, rules: rules).call(snapshot)
    report['source'] = source.metadata if source
    File.write(File.join(directory, 'report.json'), JSON.pretty_generate(report))
    warn "Report saved to #{File.join(directory, 'report.json')}"
    puts(options[:json] ? JSON.pretty_generate(report) : SlopGuard::Report.markdown(report))
    exit 2 unless report['status'] == 'complete'
  end
rescue SlopGuard::Error, OptionParser::ParseError => e
  warn SlopGuard.printable(e.message, keep_newlines: true)
  exit 2
rescue SystemCallError, Psych::Exception => e
  warn "Cannot read repository input or trusted configuration: #{e.class}"
  exit 2
end
