#!/usr/bin/env ruby
# frozen_string_literal: true

require 'bundler/setup'
require 'dotenv'
require 'optparse'
require_relative '../lib/slop_guard/eval'

options = { split: 'development', repeats: 3 }
parser = OptionParser.new do |opts|
  opts.banner = 'Usage: bin/evaluate --validate | --live [--split development|holdout] [--repeats 1..3] [--benchmark]'
  opts.on('--validate', 'Check cases and context without a model call') { options[:validate] = true }
  opts.on('--live', 'Run paid fresh evaluations') { options[:live] = true }
  opts.on('--split NAME') { |value| options[:split] = value }
  opts.on('--benchmark', 'Development benchmark: allow 1..100 repeats, stop on operational failure') do
    options[:benchmark] = true
  end
  opts.on('--repeats N', Integer) { |value| options[:repeats] = value }
  opts.on('--frozen PATH', 'Required version lock for a holdout run') { |value| options[:frozen] = value }
  opts.on('--freeze REPORT', 'Create a version lock from a passing live development report') do |value|
    options[:freeze] = value
  end
  opts.on('--env-file PATH', 'Load TYPESAFE_API_KEY from this ignored file when the environment does not set it') do |v|
    options[:env_file] = v
  end
end
begin
  parser.parse!
  raise SlopGuard::InvalidInput, parser.to_s unless ARGV.empty? && [options[:validate], options[:live],
                                                                    !options[:freeze].nil?].count(true) == 1

  if options[:benchmark] && (!options[:live] || options[:split] != 'development')
    raise SlopGuard::InvalidInput, '--benchmark requires --live --split development'
  end

  dataset = SlopGuard::Dataset.new(File.join(SlopGuard::ROOT, 'eval'))
  runner = SlopGuard::EvalRunner.new(dataset: dataset)
  if options[:validate]
    dataset.validate!
    contexts = dataset.cases.map do |entry|
      snapshot = SlopGuard::Snapshot.new(dataset.input(entry['id']), profile: SlopGuard::Profile.load('demo'))
      { 'case' => entry['id'], 'state_bytes' => JSON.generate(snapshot.state).bytesize, 'gaps' => snapshot.gaps }
    end
    puts JSON.pretty_generate('cases' => contexts, 'labels_reviewed' => dataset.manifest['labels_reviewed'],
                              'live_qualified' => false)
  elsif options[:freeze]
    path = File.join(SlopGuard::ROOT, 'tmp/frozen.json')
    FileUtils.mkdir_p(File.dirname(path))
    runner.freeze!(options[:freeze], path)
    puts path
  elsif options[:live]
    if options[:split] == 'holdout'
      unless options[:frozen] && options[:repeats] == 3
        raise SlopGuard::InvalidInput,
              'Holdout requires --frozen and three repetitions'
      end

      runner.verify_frozen!(options[:frozen])
    end
    # Credentials come from the environment; a file is read only when explicitly named. Environment wins.
    env_file = options[:env_file] || ENV.fetch('SLOP_GUARD_ENV_FILE', nil)
    if env_file
      raise SlopGuard::InvalidInput, "Credential file does not exist: #{env_file}" unless File.file?(env_file)

      Dotenv.load(env_file)
    end
    factory = ->(budget) { SlopGuard::JevClient.new(api_key: ENV.fetch('TYPESAFE_API_KEY', ''), budget: budget) }
    directory = File.join(SlopGuard::ROOT, 'tmp/evaluations',
                          "#{Time.now.utc.strftime('%Y%m%dT%H%M%S')}-#{Process.pid}")
    result = runner.run(split: options[:split], repetitions: options[:repeats], directory: directory,
                        client_factory: factory, live: true, benchmark: options.fetch(:benchmark, false))
    puts JSON.pretty_generate('passed' => result['passed'], 'metrics' => result['metrics'],
                              'report' => File.join(directory, 'report.json'))
    exit 1 unless result['passed']
  else
    raise SlopGuard::InvalidInput, parser.to_s
  end
rescue SlopGuard::Error, OptionParser::ParseError, Errno::ENOENT, JSON::ParserError => e
  warn SlopGuard.printable(e.message, keep_newlines: true)
  exit 2
end
