# Copy to ignored .env.app; do not commit real values.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_REPOSITORY_ID=
GITHUB_REPOSITORY=owner/repository
GITHUB_WEBHOOK_SECRET=
TYPESAFE_API_KEY=
# For running directly on the host; Compose supplies its own mount path.
GITHUB_PRIVATE_KEY_PATH=/absolute/path/outside/repository/private-key.pem
SLOP_GUARD_DATA_DIR=./tmp/app
