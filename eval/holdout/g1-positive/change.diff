+require_relative '../../lib/path_tracker/pages'
+RSpec.describe PathTracker::Pages do
+  it 'counts visits across pages' do
+    pages = described_class.new
+    pages.add_page('/one').add_visit('127.0.0.1')
+    pages.add_page('/two').add_visit('127.0.0.1')
+    expect(pages.pages.size).to eq(2)
+  end
