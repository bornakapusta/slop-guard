--- a/lib/presenters/csv_report.rb
+++ b/lib/presenters/csv_report.rb
@@ -0,0 +1,8 @@
+# frozen_string_literal: true
+module Presenters
+  class CsvReport
+    def self.render(pages)
+      pages.pages.map { |page| "#{page.path},#{page.visits_count}" }.join("\n")
+    end
+  end
+end
