--- a/lib/presenters/visit_summary.rb
+++ b/lib/presenters/visit_summary.rb
@@ -0,0 +1,8 @@
+# frozen_string_literal: true
+module Presenters
+  class VisitSummary
+    def self.print(page)
+      puts "#{page.path}: #{page.visits_count} visits"
+    end
+  end
+end
