--- a/lib/presenters/report_format.rb
+++ b/lib/presenters/report_format.rb
@@ -0,0 +1,9 @@
+# frozen_string_literal: true
+module Presenters
+  class ReportFormat
+    FORMATS = { plain: ->(page) { "#{page.path}: #{page.visits_count}" } }.freeze
+    def self.render(page, format: :plain)
+      FORMATS.fetch(format).call(page)
+    end
+  end
+end
