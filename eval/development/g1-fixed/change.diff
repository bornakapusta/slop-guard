+# frozen_string_literal: true
+require_relative '../../lib/path_tracker/page'
+RSpec.describe PathTracker::Page do
+  it 'counts repeated IP visits' do
+    page = described_class.new('/home')
+    2.times { page.add_visit('127.0.0.1') }
+    expect(page.visits_for('127.0.0.1')).to eq(2)
+  end
+end
